package admin

import (
	"fmt"

	"encoding/json"
	"github.com/manuellara/ipam/cmd/views/shared"
	"github.com/manuellara/ipam/internal/db"
	"github.com/manuellara/ipam/internal/middleware"
)

type SiteEnvMapFormData struct {
	ID             int64
	IsEdit         bool
	NamingSchemeID int64
	SiteCode       string
	EnvCode        string
	SubnetID       int64
	Active         bool
	ErrMsg         string
}

type SchemeOption struct {
	ID   int64
	Name string
}

type SubnetOption struct {
	ID    int64
	Label string
}

type TokenOption struct {
	Code  string `json:"code"`
	Label string `json:"label"`
}

func formAction(data SiteEnvMapFormData) string {
	if data.IsEdit {
		return fmt.Sprintf("/admin/site-env-map/%d", data.ID)
	}
	return "/admin/site-env-map"
}

// SchemeTokensJSON builds the {schemeID: {"site": [...], "env": [...]}}
// structure Alpine uses to filter site/env options as the scheme
// dropdown changes. schemeID keys are stringified because JSON object
// keys are always strings.
func SchemeTokensJSON(rows []db.ListActiveSiteEnvTokenValuesRow) (string, error) {
	byScheme := make(map[string]map[string][]TokenOption)
	for _, r := range rows {
		key := fmt.Sprint(r.SchemeID)
		if byScheme[key] == nil {
			byScheme[key] = map[string][]TokenOption{"site": {}, "env": {}}
		}
		byScheme[key][r.Token] = append(byScheme[key][r.Token], TokenOption{Code: r.Code, Label: r.Label})
	}
	b, err := json.Marshal(byScheme)
	if err != nil {
		return "", err
	}
	return string(b), nil
}

templ SiteEnvMapFormPage(principal middleware.Principal, data SiteEnvMapFormData, schemes []SchemeOption, subnets []SubnetOption, tokensJSON string) {
	@shared.Boilerplate("IPAM — Site/Env Mapping") {
		@shared.Layout(shared.Sidebar(principal), SiteEnvMapFormMain(data, schemes, subnets, tokensJSON))
	}
}

templ SiteEnvMapFormMain(data SiteEnvMapFormData, schemes []SchemeOption, subnets []SubnetOption, tokensJSON string) {
	<div
		class="container"
		x-data={ fmt.Sprintf(`{
			schemeTokens: %s,
			selectedScheme: '%d',
			selectedSite: %q,
			selectedEnv: %q,
			get siteOptions() { return (this.schemeTokens[this.selectedScheme] || {}).site || [] },
			get envOptions() { return (this.schemeTokens[this.selectedScheme] || {}).env || [] },
		}`, tokensJSON, data.NamingSchemeID, data.SiteCode, data.EnvCode) }
	>
		<header style="margin-bottom: 1.5rem;">
			if data.IsEdit {
				<h1 style="margin-bottom: 0;">Edit Mapping</h1>
			} else {
				<h1 style="margin-bottom: 0;">New Mapping</h1>
			}
			<p style="margin-top: 0.5rem; opacity: 0.72;">
				if data.IsEdit {
					Update the naming scheme, site, environment, and subnet mapping.
				} else {
					Create a subnet mapping for a naming scheme, site, and environment.
				}
			</p>
		</header>
		if data.ErrMsg != "" {
			<div class="error mb-4" role="alert" data-variant="error" style="margin-bottom: 1rem;">
				<strong>Error!</strong> { data.ErrMsg }
			</div>
		}
		<section style="max-width: 42rem; margin: 0 auto;">
			<form method="POST" action={ templ.URL(formAction(data)) } style="display: block;">
				<fieldset style="border: 1px solid rgba(17, 24, 39, 0.16); border-radius: 0.75rem; padding: 1.25rem 1.25rem 1rem; background: rgba(255, 255, 255, 0.02);">
					<legend style="padding: 0 0.5rem; font-weight: 600;">Mapping details</legend>
					<label for="scheme" style="display: block; margin-top: 0.5rem; margin-bottom: 0.35rem; font-weight: 600;">Naming scheme</label>
					<select id="scheme" name="naming_scheme_id" x-model="selectedScheme" required style="width: 100%; box-sizing: border-box; margin-bottom: 1rem;">
						for _, s := range schemes {
							<option value={ fmt.Sprint(s.ID) } selected?={ s.ID == data.NamingSchemeID }>{ s.Name }</option>
						}
					</select>
					<label for="site" style="display: block; margin-bottom: 0.35rem; font-weight: 600;">Site</label>
					<select id="site" name="site_code" x-model="selectedSite" required style="width: 100%; box-sizing: border-box; margin-bottom: 1rem;">
						<template x-for="opt in siteOptions" :key="opt.code">
							<option :value="opt.code" x-text="opt.label" :selected="opt.code === selectedSite"></option>
						</template>
					</select>
					<label for="env" style="display: block; margin-bottom: 0.35rem; font-weight: 600;">Env</label>
					<select id="env" name="env_code" x-model="selectedEnv" required style="width: 100%; box-sizing: border-box; margin-bottom: 1rem;">
						<template x-for="opt in envOptions" :key="opt.code">
							<option :value="opt.code" x-text="opt.label" :selected="opt.code === selectedEnv"></option>
						</template>
					</select>
					<label for="subnet" style="display: block; margin-bottom: 0.35rem; font-weight: 600;">Subnet</label>
					<select id="subnet" name="subnet_id" required style="width: 100%; box-sizing: border-box; margin-bottom: 1rem;">
						for _, s := range subnets {
							<option value={ fmt.Sprint(s.ID) } selected?={ s.ID == data.SubnetID }>{ s.Label }</option>
						}
					</select>
					<div style="display: block; margin-bottom: 0.75rem;">
						<label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; margin: 0;">
							<input type="checkbox" role="switch" name="active" value="1" checked?={ data.Active }/>
							Active
						</label>
					</div>
					<button type="submit" style="display: block; margin-top: 0.5rem;">
						if data.IsEdit {
							Save
						} else {
							Create
						}
					</button>
				</fieldset>
			</form>
		</section>
	</div>
}

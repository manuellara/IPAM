package shared

// Layout renders the oat top nav bar plus an always-collapsible sidebar (see https://oat.ink/components/#sidebar).
templ Layout(sidebar templ.Component, main templ.Component) {
	<div data-sidebar-layout="always">
		<nav data-topnav>
			<button type="button" data-sidebar-toggle aria-label="Toggle sidebar">☰</button>
			<strong>IPAM</strong>
			<form method="POST" action="/logout" style="margin-left: auto;">
				<button type="submit">Log out</button>
			</form>
		</nav>
		<aside data-sidebar>
			@sidebar
		</aside>
		<main style="display: flex; flex-direction: column;">
			@main
			@Footer()
		</main>
	</div>
}

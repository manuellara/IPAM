package shared

// Footer is rendered by the authenticated page layout.
templ Footer() {
	<footer style="display: flex; align-items: center; justify-content: center; margin-block-start: auto; padding: 1rem; border-top: 1px solid var(--border);">
		<a href="https://buymeacoffee.com/manuellara" aria-label="Support this project">
			<img src="/static/images/bmc-logo.svg" alt="Support this project" style="display: block; height: 25px; width: auto;" />
		</a>
	</footer>
}

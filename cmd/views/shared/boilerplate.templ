package shared

// Boilerplate is the root HTML document shared by every page. Page-specific
// markup is passed in as children and rendered inside <main>.
templ Boilerplate(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/oat/oat.min.css"/>
			<script src="/static/htmx/htmx.min.js"></script>
			<script src="/static/alpine/cdn.min.js" defer></script>
			<script src="/static/oat/oat.min.js"></script>
		</head>
		<body>
			<main style="padding: 0;">
				{ children... }
			</main>
		</body>
	</html>
}
